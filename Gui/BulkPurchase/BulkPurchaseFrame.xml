                <Texture name='$parentBackTex' file='Interface\MoneyFrame\UI-MoneyFrame2'>
                    <Anchors>
                        <Anchor point='TOPLEFT' relativeTo='$parentTopTex' relativePoint='BOTTOMLEFT'/>
