                                    <Offset x='18' y='0'/>
                                </Anchor>
                            </Anchors>
                        </Texture>
                        <FontString name='KrowiEVU_BulkCurrencyAmt2' inherits='GameFontHighlightSmall'>
                            <Anchors>
                                <Anchor point='RIGHT' relativeTo='KrowiEVU_BulkCurrency2' relativePoint='LEFT'>
                                    <Offset x='-2' y='0'/>
                                </Anchor>
                            </Anchors>
                        </FontString>
                        <Texture name='KrowiEVU_BulkCurrency3'>
                            <Size x='16' y='16'/>
                            <Anchors>
                                <Anchor point='LEFT' relativeTo='KrowiEVU_BulkCurrency2' relativePoint='RIGHT'>
                                    <Offset x='18' y='0'/>
                                </Anchor>
                            </Anchors>
                        </Texture>
                        <FontString name='KrowiEVU_BulkCurrencyAmt3' inherits='GameFontHighlightSmall'>
                            <Anchors>
                                <Anchor point='RIGHT' relativeTo='KrowiEVU_BulkCurrency3' relativePoint='LEFT'>
                                    <Offset x='-2' y='0'/>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <Scripts>
            <OnChar>KrowiEVU_BulkPurchaseMixin:OnChar(text)</OnChar>
            <OnKeyDown>KrowiEVU_BulkPurchaseMixin:OnKeyDown(key)</OnKeyDown>
            <OnHide>KrowiEVU_BulkPurchaseMixin:OnHide()</OnHide>
        </Scripts>
