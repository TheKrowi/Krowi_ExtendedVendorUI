                        </Texture>
                        <FontString name='KrowiEVU_BulkCurrencyAmt1' inherits='GameFontHighlightSmall'>
                            <Anchors>
                                <Anchor point='RIGHT' relativeTo='KrowiEVU_BulkCurrency1' relativePoint='LEFT'>
                                    <Offset x='-2' y='0'/>
                                </Anchor>
                            </Anchors>
                        </FontString>
                        <Texture name='KrowiEVU_BulkCurrency2'>
                            <Size x='16' y='16'/>
