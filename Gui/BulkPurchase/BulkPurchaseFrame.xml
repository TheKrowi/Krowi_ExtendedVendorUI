            <Button name='KrowiEVU_BulkBuyButton' inherits='UIPanelButtonTemplate' text='OKAY'>
                <Size x='78' y='24'/>
                <Anchors>
                    <Anchor point='RIGHT' relativePoint='BOTTOM'>
                        <Offset><AbsDimension x='-3' y='30'/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>KrowiEVU_BulkPurchaseMixin:Buy_Click()</OnClick>
                </Scripts>
            </Button>
            <Button name='KrowiEVU_BulkCancelButton' inherits='UIPanelButtonTemplate' text='CANCEL'>
                <Size x='78' y='24'/>
                <Anchors>
                    <Anchor point='LEFT' relativePoint='BOTTOM'>
                        <Offset><AbsDimension x='5' y='30'/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>KrowiEVU_BulkPurchaseMixin:Cancel_Click()</OnClick>
                </Scripts>
            </Button>

            <Button name='KrowiEVU_BulkStackButton' inherits='UIPanelButtonTemplate'>
                <Size x='78' y='24'/>
                <Anchors>
                    <Anchor point='BOTTOM' relativeTo='KrowiEVU_BulkBuyButton' relativePoint='TOP'>
                        <Offset><AbsDimension x='0' y='2'/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>self:RegisterForClicks('LeftButtonUp', 'RightButtonUp')</OnLoad>
                    <OnClick>KrowiEVU_BulkPurchaseMixin:Stack_Click(self, button)</OnClick>
                    <OnEnter>KrowiEVU_BulkPurchaseMixin:OnEnter(self)</OnEnter>
                    <OnLeave>KrowiEVU_BulkPurchaseMixin:OnLeave()</OnLeave>
                </Scripts>
            </Button>
            <Button name='KrowiEVU_BulkMaxButton' inherits='UIPanelButtonTemplate'>
                <Size x='78' y='24'/>
                <Anchors>
                    <Anchor point='BOTTOM' relativeTo='KrowiEVU_BulkCancelButton' relativePoint='TOP'>
                        <Offset><AbsDimension x='0' y='2'/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>KrowiEVU_BulkPurchaseMixin:Max_Click()</OnClick>
                    <OnEnter>KrowiEVU_BulkPurchaseMixin:OnEnter(self)</OnEnter>
                    <OnLeave>KrowiEVU_BulkPurchaseMixin:OnLeave()</OnLeave>
                </Scripts>
            </Button>

