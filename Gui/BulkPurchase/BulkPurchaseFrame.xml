                        <Offset><AbsDimension x='-60' y='-8'/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>KrowiEVU_BulkPurchaseMixin:Left_Click()</OnClick>
                </Scripts>
                <NormalTexture file='Interface\MoneyFrame\Arrow-Left-Up'/>
                <PushedTexture file='Interface\MoneyFrame\Arrow-Left-Down'/>
                <DisabledTexture file='Interface\MoneyFrame\Arrow-Left-Disabled'/>
            </Button>
            <Button name='KrowiEVU_BulkRightButton'>
                <Size x='16' y='16'/>
                <Anchors>
                    <Anchor point='TOPLEFT' relativeTo='KrowiEVU_BulkMoneyTex' relativePoint='TOP'>
                        <Offset><AbsDimension x='63' y='-8'/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>KrowiEVU_BulkPurchaseMixin:Right_Click()</OnClick>
                </Scripts>
                <NormalTexture file='Interface\MoneyFrame\Arrow-Right-Up'/>
                <PushedTexture file='Interface\MoneyFrame\Arrow-Right-Down'/>
